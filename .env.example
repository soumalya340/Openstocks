# Copy to .env and adjust as needed:
#   cp .env.example .env

PORT=3000
JWT_SECRET=change-me-in-production

# Required — Postgres / Supabase connection string.
# Encode special characters in the password (@ → %40, etc.).
# Example:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_URL=

# Optional Supabase REST credentials (not required for SQL via DATABASE_URL):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Global HTTP rate limit (per IP across all routes)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
